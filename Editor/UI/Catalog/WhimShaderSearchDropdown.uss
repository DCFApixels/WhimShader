/* SearchWindow reference geometry: 7 px top / 8 px sides, search 20,
   pages at y=30, category header 25, item row 20, icon 16 logical px. */
.whimshader-search-popup { overflow: hidden; }
.whimshader-search-input {
    width: auto;
    min-width: 0;
    margin-top: 7px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 0;
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
}
.whimshader-search-viewport { position: absolute; top: 30px; bottom: 0; left: 1px; right: 1px; overflow: hidden; }
.whimshader-search-page { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.whimshader-search-header { height: 25px; flex-shrink: 0; justify-content: center; }
.whimshader-search-title { flex-grow: 1; margin: 0; white-space: nowrap; overflow: hidden; }
.whimshader-search-list { flex-grow: 1; min-height: 0; }
.whimshader-search-row { flex-direction: row; align-items: center; height: 20px; flex-shrink: 0; overflow: hidden; }
.whimshader-search-row-background { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.whimshader-search-row-accent { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; }
.whimshader-search-popup--accented .whimshader-search-viewport { left: 0; }
.whimshader-search-row-label { flex-grow: 1; min-width: 0; margin: 0; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.whimshader-search-icon { width: 16px; height: 16px; margin-right: 2px; flex-shrink: 0; }
.whimshader-search-back, .whimshader-search-forward { position: absolute; top: 50%; translate: 0 -50%; }
.whimshader-search-empty { margin: 8px; -unity-text-align: middle-center; opacity: 0.65; }

.whimshader-search-toolbar { flex-direction: row; height: 27px; margin: 0 8px; align-items: flex-end; }
.whimshader-search-toolbar .whimshader-search-input { flex-grow: 1; margin-left: 0; margin-right: 0; }
.whimshader-search-row .whimshader-graph-catalog-preview--large { margin-left: 5px; }
